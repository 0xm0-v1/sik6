# Example of environment variables for local development / documentation
# Copy this as `.env.development` (or `.env`) and fill real values.

HOST=localhost
PORT=8080
ENV=dev
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOW_CREDENTIALS=false

# Durations: specify unit (s, ms, etc)
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s
READ_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# You can add other variables as needed, e.g.
# DB_DSN=postgres://user:pass@host:port/dbname
# CACHE_URL=redis://localhost:6379

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=PWD
DB_NAME=name
DB_SSLMODE=disable
POSTGRES_DB=name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PWD

# API token for protected endpoints (set Authorization: Bearer <token>)
API_TOKEN=
